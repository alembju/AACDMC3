
const mongoose = require("mongoose");

const RegisterSchema = new mongoose.Schema({
   orgname:String,
    title:String,
    principal:String,
    phone:String,
    dsharing:String,
    availability:String,
    raw:String,
    coverage:String,
    BGDate:Date,
    LDate:Date,
    date:String,
    gender:String,
    type:String,
    cleaned:String,
    url:String,
    comments:String,
    email:String,
  filename:String,
  public_id:String,
  imgUrl:String, 
},
{
  timestamps: true // This automatically adds 'createdAt' and 'updatedAt' fields
}
);
module.exports = mongoose.model('register', RegisterSchema);