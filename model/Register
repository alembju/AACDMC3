
const mongoose = require("mongoose");

const RegisterSchema = new mongoose.Schema({
   orgname:String,
    Title:String,
    principal:String,
    phone:String,
    dsharing:String,
    availability:String,
    raw:String,
    coverage:String,
    BGDate:Date,
    LDate:Date,
    date:String,
    gender:String,
    type:String,
    cleaned:String,
    urlLink:String,
    comments:String,
    email:String,
    public_id:String,
    url:String,
    original_filename:String, 
    format:String,
},
{
  timestamps: true // This automatically adds 'createdAt' and 'updatedAt' fields
}
);
module.exports = mongoose.model('register', RegisterSchema);